<mujoco model="TB3-WafflePi scene">             <!--Pulls in robot from its own file -->
  <include file="turtlebot3_waffle_pi.xml"/>  

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>    <!--Lighting and camera angle in the viewer-->
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset> <!-- Pictures and colour that will be used-->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <texture name="aruco_tex" type="2d" file="aruco_0.png"/> <!-- Loads ArUco marker in-->
    <material name="aruco_mat" texture="aruco_tex"/> 
    <material name="wall_mat" rgba="0.8 0.8 0.8 1"/> <!-- Configures the wall material and colour-->
    <material name="obstacle_mat" rgba="0.85 0.45 0.2 1"/> <!-- configures obstacle material and colour-->
  </asset>

  <worldbody> <!-- Everything that physically exists -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Room: 5 m x 5 m, walls 0.5 m tall -->
    <geom name="wall_north" type="box" pos="0 2.5 0.25"  size="2.5 0.05 0.25" material="wall_mat"/> <!-- Creation of walls: name = name, type = makes rectangular box, pos = where its centre is, size = size, material = wall_mat (painting it grey)-->
    <geom name="wall_south" type="box" pos="0 -2.5 0.25" size="2.5 0.05 0.25" material="wall_mat"/>
    <geom name="wall_east"  type="box" pos="2.5 0 0.25"  size="0.05 2.5 0.25" material="wall_mat"/>
    <geom name="wall_west"  type="box" pos="-2.5 0 0.25" size="0.05 2.5 0.25" material="wall_mat"/>

    <!-- Obstacles (move these to change the course) -->
    <geom name="obstacle_1" type="box"      pos="1.2 0.1 0.15"  size="0.15 0.15 0.15" material="obstacle_mat"/> 
    <geom name="obstacle_2" type="box"      pos="0.4 -1.2 0.15" size="0.2 0.2 0.15"   material="obstacle_mat"/>
    <geom name="obstacle_3" type="cylinder" pos="-1.0 1.0 0.15" size="0.15 0.15"      material="obstacle_mat"/>

    <!-- Docking station on the east wall, marker facing back into the room -->
    <body name="dock" pos="2.44 0 0.15">
      <geom name="dock_marker" type="box" size="0.005 0.125 0.125" material="aruco_mat"/>
    </body>
  </worldbody>
</mujoco>